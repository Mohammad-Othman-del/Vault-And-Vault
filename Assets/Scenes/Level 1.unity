PrefabInstance:
  m_ObjectHideFlags: 0
  serializedVersion: 2
  m_Modification:
    serializedVersion: 3
    m_TransformParent: {fileID: 0}
    m_Modifications:
    - target: {fileID: 1640901573787966622, guid: 7dd4573c638e8c495848395f8c285284, type: 3}
      propertyPath: nextDialogue
